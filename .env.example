OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# Defaults: GPT Terra watches frames + writes plans. Grok searches X and judges.
# XLOG_GEMINI_MODEL=gemini-3.5-flash-lite
# XLOG_GROK_MODEL=grok-4.6
# XLOG_OPENAI_EDITOR_MODEL=gpt-5.6-terra
# XLOG_OPENAI_EDITOR_EFFORT=none   # no reasoning tax; quoting the frame is the job
# XLOG_USE_GROK_FOR_WRITER=0
# XLOG_GROK_TRENDS=on     # on = every job x_search; auto = funny briefs only; off = never
# XLOG_QUALITY=fast       # fast | pro — local both selectable; Pro subscribe later locks pro
# XLOG_PRO_UNLOCKED=1     # 0 = force fast even if the UI asks for pro
# XLOG_OUTPUT_FIT=1       # 1 = letterbox longform (no 9:16 crop); 0 = old cover-crop
# XLOG_STT_MODEL=whisper-1   # filler-word trim on shot spans only (~$0.006/min)
# XLOG_MAX_UPLOAD_MB=16384   # per file; local 4K .mov is often >2GB
# XLOG_SOURCE_MAX_SEC=3600   # max source length (default 60min); Gemini cost scales with length
# Supabase (xlog project) — learning memory backend
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_anon_or_service_role_key
